---
import "../styles/projects.css";
import { Image } from "astro:assets";
import { ExternalLink, Github, Folder, Star } from "@lucide/astro";

// Import project images
import ProjectImage1 from "../assets/project-1.png";
import ProjectImage2 from "../assets/project-2.png";
import ProjectImage3 from "../assets/project-3.png";

//  Typescript interface for Project
interface Project {
    id: string;
    title: string;
    description: string;
    image?: ImageMetadata;
    technologies: string[];
    liveUrl?: string;
    repoUrl?: string;
    featured?: boolean;
    category: "web" | "mobile" | "api" | "other";
}

// Projects Data
const projects: Project[] = [
    {
        id: "project-1",
        title: "Portfolio",
        description:
            "Mí sitio web personal para mostrar mis proyectos, habilidades y experiencia como desarrollador web.",
        image: ProjectImage1, 
        technologies: ["Astro", "TypeScript", "CSS", "JavaScript"],
        liveUrl: "https://portafolio-ramon-ruiz.vercel.app/",
        repoUrl: "https://github.com/mister-ramoon/portafolio", 
        featured: true,
        category: "web",
    },
    {
        id: "project-2",
        title: "NASA OPEN API",
        description:
            "Aplicación web que consume su API pública de la NASA para mostrar imágenes diarias, datos de misiones y eventos astronómicos.",
        image: ProjectImage2, 
        technologies: ["Next.js", "TypeScript", "Tailwind CSS", "React"],
        liveUrl: "https://nasa-open.vercel.app/",
        repoUrl: "https://github.com/mister-ramoon/nasa-open",
        featured: true,
        category: "web",
    },
    {
        id: "project-3",
        title: "Springfield-DB",
        description:
            "Aplicación web para consultar información sobre personajes, episodios y ubicaciones de la serie Los Simpson utilizando una API pública.",
        image: ProjectImage3, 
        technologies: ["Vite.js", "JavaScript", "CSS", "Fetch API"],
        liveUrl: "https://springfield-db.vercel.app/",
        repoUrl: "https://github.com/mister-ramoon/Springfield-DB/tree/main",
        featured: true,
        category: "web",
    },
    {
        id: "project-4",
        title: "Google Clone",
        description:
            "Clon de la página principal de Google con funcionalidades básicas de búsqueda y diseño responsivo.",
        technologies: ["HTML", "JavaScript", "CSS"],
        liveUrl: "https://mister-ramoon.github.io/google-clone/", 
        repoUrl: "https://github.com/mister-ramoon/google-clone",
        featured: false,
        category: "web",
    },
    {
        id: "project-5",
        title: "Platzi Video",
        description:
            "Web estatica de una plataforma de streaming de video similar a Netflix, con catálogo de películas y series.",
        technologies: ["HTML", "JavaScript", "CSS"], 
        liveUrl: "https://mister-ramoon.github.io/platzi-video-frontend/platzi-video/",
        repoUrl: "https://github.com/mister-ramoon/platzi-video-frontend",
        featured: false,
        category: "web",
    },
];

// Separate featured and other projects
const featuredProjects = projects.filter((p) => p.featured);
const otherProjects = projects.filter((p) => !p.featured);
---

<section class="projects-section" id="projects">
    <div class="section-header">
        <h2 class="section-title">Proyectos</h2>
        <p class="section-subtitle">
            Una selección de mis trabajos más recientes
        </p>
    </div>

    <!-- Featured Projects -->
    {
        featuredProjects.length > 0 && (
            <div class="featured-projects">
                <h3 class="subsection-title">
                    <Star class="icon" />
                    Proyectos Destacados
                </h3>
                <div class="featured-grid">
                    {featuredProjects.map((project, index) => (
                        <article
                            class="project-card featured glass-card"
                            style={`--delay: ${index * 0.1}s`}
                        >
                            <div class="project-image-container">
                                {project.image ? (
                                    <Image
                                        src={project.image}
                                        alt={`Imagen del proyecto ${project.title}`}
                                        class="project-image"
                                        loading="lazy"
                                    />
                                ) : (
                                    <div class="project-image-placeholder">
                                        <Folder class="placeholder-icon" />
                                    </div>
                                )}
                                <div class="project-overlay">
                                    <div class="project-links">
                                        {project.liveUrl && (
                                            <a
                                                href={project.liveUrl}
                                                class="project-link glass-btn"
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                aria-label="Ver proyecto en vivo"
                                            >
                                                <ExternalLink class="icon" />
                                            </a>
                                        )}
                                        {project.repoUrl && (
                                            <a
                                                href={project.repoUrl}
                                                class="project-link glass-btn"
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                aria-label="Ver código en GitHub"
                                            >
                                                <Github class="icon" />
                                            </a>
                                        )}
                                    </div>
                                </div>
                            </div>
                            <div class="project-content">
                                <h4 class="project-title">{project.title}</h4>
                                <p class="project-description">
                                    {project.description}
                                </p>
                                <div class="project-technologies">
                                    {project.technologies.map((tech) => (
                                        <span class="tech-tag">{tech}</span>
                                    ))}
                                </div>
                            </div>
                        </article>
                    ))}
                </div>
            </div>
        )
    }

    <!-- Other Projects -->
    {
        otherProjects.length > 0 && (
            <div class="other-projects">
                <h3 class="subsection-title">
                    <Folder class="icon" />
                    Otros Proyectos
                </h3>
                <div class="projects-grid">
                    {otherProjects.map((project, index) => (
                        <article
                            class="project-card glass-card"
                            style={`--delay: ${index * 0.1}s`}
                        >
                            <div class="project-card-header">
                                <Folder class="folder-icon" />
                                <div class="project-header-links">
                                    {project.repoUrl && (
                                        <a
                                            href={project.repoUrl}
                                            class="header-link"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            aria-label="Ver código en GitHub"
                                        >
                                            <Github class="icon-sm" />
                                        </a>
                                    )}
                                    {project.liveUrl && (
                                        <a
                                            href={project.liveUrl}
                                            class="header-link"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            aria-label="Ver proyecto en vivo"
                                        >
                                            <ExternalLink class="icon-sm" />
                                        </a>
                                    )}
                                </div>
                            </div>
                            <div class="project-content">
                                <h4 class="project-title">{project.title}</h4>
                                <p class="project-description">
                                    {project.description}
                                </p>
                            </div>
                            <div class="project-footer">
                                <div class="project-technologies">
                                    {project.technologies
                                        .slice(0, 4)
                                        .map((tech) => (
                                            <span class="tech-tag small">
                                                {tech}
                                            </span>
                                        ))}
                                </div>
                            </div>
                        </article>
                    ))}
                </div>
            </div>
        )
    }
</section>
