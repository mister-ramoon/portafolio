---
import "../styles/about.css";
import { Code2, Palette, Rocket, GraduationCap, Calendar } from "@lucide/astro";

// Personal Information
const personalInfo = {
    name: "Ramón Ruiz",
    role: "Desarrollador Web Full Stack",
    bio: `Soy un desarrollador apasionado por crear experiencias digitales únicas y funcionales. 
          Con más de 5 años de experiencia en el desarrollo web, me especializo en construir 
          aplicaciones modernas, escalables y con excelente experiencia de usuario.`,
};

// Education
interface Education {
    id: string;
    degree: string;
    institution: string;
    location?: string;
    startYear: string;
    endYear: string;
    description?: string;
    achievements?: string[];
}

const education: Education[] = [
    {
        id: "edu-1",
        degree: "Licenciatura en Ciencias de la Computación",
        institution: "Universidad Nacional Autónoma de México",
        startYear: "2013",
        endYear: "2017",
    },
    {
        id: "edu-2",
        degree: "Certificación en Desarrollo Full Stack",
        institution: "Platzi",
        startYear: "2019",
        endYear: "2020",
    },
    {
        id: "edu-3",
        degree: "AWS Certified Developer",
        institution: "Amazon Web Services",
        startYear: "2022",
        endYear: "2022",
    },
];

// Skills
const skills = [
    {
        category: "Frontend",
        icon: "palette",
        items: [
            "React",
            "Vue.js",
            "Astro",
            "TypeScript",
            "Tailwind CSS",
            "SASS",
        ],
    },
    {
        category: "Backend",
        icon: "code",
        items: [
            "Node.js",
            "Express",
            "Python",
            "PostgreSQL",
            "MongoDB",
            "GraphQL",
        ],
    },
    {
        category: "Herramientas",
        icon: "rocket",
        items: ["Git", "Docker", "AWS", "Vercel", "Figma", "VS Code"],
    },
];
---

<section class="about-section" id="about">
    <div class="section-header">
        <h2 class="section-title">Sobre Mí</h2>
        <p class="section-subtitle">Conoce un poco más sobre quién soy</p>
    </div>

    <div class="about-container">
        <!-- Bio Card -->
        <div class="bio-card glass-card">
            <div class="bio-header">
                <div class="bio-avatar">
                    <span class="avatar-emoji">👨‍💻</span>
                </div>
                <div class="bio-intro">
                    <h3 class="bio-name">{personalInfo.name}</h3>
                    <p class="bio-role">{personalInfo.role}</p>
                </div>
            </div>

            <p class="bio-text">{personalInfo.bio}</p>

            <!-- Education Section -->
            <div class="education-section">
                <h4 class="education-title">
                    <GraduationCap class="icon" />
                    Educación
                </h4>
                <div class="education-list">
                    {
                        education.map((edu, index) => (
                            <div
                                class="education-item"
                                style={`--delay: ${index * 0.1}s`}
                            >
                                <div class="education-icon">
                                    <GraduationCap class="icon-sm" />
                                </div>
                                <div class="education-content">
                                    <div class="education-header">
                                        <h5 class="education-degree">
                                            {edu.degree}
                                        </h5>
                                        <span class="education-year">
                                            <Calendar class="icon-xs" />
                                            {edu.startYear} - {edu.endYear}
                                        </span>
                                    </div>
                                    <p class="education-institution">
                                        {edu.institution}
                                    </p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>

        <!-- Skills Section -->
        <div class="skills-section">
            <h3 class="skills-main-title">
                <Code2 class="icon" />
                Habilidades
            </h3>

            <div class="skills-grid">
                {
                    skills.map((skillGroup, index) => (
                        <div
                            class="skill-card glass-card"
                            style={`--delay: ${index * 0.1}s`}
                        >
                            <div class="skill-header">
                                <div class="skill-icon">
                                    {skillGroup.icon === "palette" && (
                                        <Palette class="icon" />
                                    )}
                                    {skillGroup.icon === "code" && (
                                        <Code2 class="icon" />
                                    )}
                                    {skillGroup.icon === "rocket" && (
                                        <Rocket class="icon" />
                                    )}
                                </div>
                                <h4 class="skill-category">
                                    {skillGroup.category}
                                </h4>
                            </div>
                            <div class="skill-items">
                                {skillGroup.items.map((item) => (
                                    <span class="skill-item">{item}</span>
                                ))}
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>
